{
  "name": "dsh-subagent-forge",
  "version": "1.2.0",
  "type": "module",
  "description": "Configurable subagents for DeepSeek Harness: a per-child system prompt, a model allowlist with descriptions, reasoning effort, and an explicit per-launch delegation grant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/00wz/dsh-subagent-forge.git"
  },
  "homepage": "https://github.com/00wz/dsh-subagent-forge#readme",
  "bugs": {
    "url": "https://github.com/00wz/dsh-subagent-forge/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "subagent",
    "delegation",
    "cordis"
  ],
  "engines": {
    "dsh": ">=0.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./bridge": "./bridge.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "bridge.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
